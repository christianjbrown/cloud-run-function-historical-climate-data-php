{
    "name": "christianjbrown/php-gcp-function-historical-climate-data",
    "description": "A PHP 8.5+ Google Cloud Function that returns per-day or per-hour min/max temperature and humidity (inside from SmartThings, outside from the Met Office) over a lookback window.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "google-cloud",
        "cloud-run",
        "cloud-functions",
        "serverless",
        "climate",
        "history",
        "aggregation"
    ],
    "authors": [
        {
            "name": "Christian Brown"
        }
    ],
    "require": {
        "php": "^8.5",
        "christianjbrown/php-christianbrown-database-orm": "dev-main",
        "christianjbrown/php-gcp-function-lib": "dev-main",
        "christianjbrown/php-user-friendly-exception-lib": "dev-main",
        "google/cloud-functions-framework": "^1.1"
    },
    "require-dev": {
        "christianjbrown/php-code-quality-scripts": "dev-main",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "ChristianBrown\\HistoricalClimateData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChristianBrown\\HistoricalClimateData\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "clear && (export $(grep -v '^#' .local.env | xargs) && FUNCTION_SOURCE=index.php FUNCTION_TARGET=run FUNCTION_SIGNATURE_TYPE=http php -d error_reporting=\"E_ALL & ~E_DEPRECATED\" -S localhost:${PORT:-8080} ./bin/router.php)"
        ],
        "test": [
            "clear && XDEBUG_MODE=coverage php -d memory_limit=-1 ./bin/phpunit && open ./.phpunit.cache/code-coverage-html/index.html"
        ],
        "stan": [
            "clear && ./bin/phpstan analyse"
        ],
        "check-style": [
            "clear && ./bin/php-cs ./src ./tests"
        ],
        "check-style-diff": [
            "clear && ./bin/php-cs-diff"
        ],
        "fix-style": [
            "clear && ./bin/php-cs-fix ./src ./tests"
        ],
        "fix-style-diff": [
            "clear && ./bin/php-cs-fix-diff"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "repositories": [
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/php-christianbrown-database-orm.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/php-code-quality-scripts.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/php-gcp-function-lib.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/php-key-value-store-lib.git"
        },
        {
            "type": "github",
            "url": "git@github.com:christianjbrown/php-user-friendly-exception-lib.git"
        }
    ]
}
